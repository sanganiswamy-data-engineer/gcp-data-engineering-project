WITH versions AS (
  SELECT
    AccountID,
    version_number,
    CustomerID,
    BranchID,
    AccountTypeID,
    SortCode,
    AccountNumber,
    OpenDate,
    CloseDate,
    Status,
    CurrentBalance,
    Currency
  FROM `retail-omkar-cli-org-dev.bankeva_gold_test.accounts`
  WHERE AccountID IN ('6', '8', '9', '10', '11', '12', '13')
),
paired AS (
  SELECT
    old.AccountID,
    old AS old_record,
    new1 AS new_record
  FROM versions old
  JOIN versions new1
    ON old.AccountID = new1.AccountID
   AND old.version_number = 1
   AND new1.version_number = 2
)
SELECT
  AccountID,
  ARRAY_TO_STRING(
    ARRAY(
      SELECT column_name
      FROM UNNEST([
        STRUCT('CustomerID' AS column_name, old_record.CustomerID IS DISTINCT FROM new_record.CustomerID AS changed),
        STRUCT('BranchID', old_record.BranchID IS DISTINCT FROM new_record.BranchID),
        STRUCT('AccountTypeID', old_record.AccountTypeID IS DISTINCT FROM new_record.AccountTypeID),
        STRUCT('SortCode', old_record.SortCode IS DISTINCT FROM new_record.SortCode),
        STRUCT('AccountNumber', old_record.AccountNumber IS DISTINCT FROM new_record.AccountNumber),
        STRUCT('OpenDate', old_record.OpenDate IS DISTINCT FROM new_record.OpenDate),
        STRUCT('CloseDate', old_record.CloseDate IS DISTINCT FROM new_record.CloseDate),
        STRUCT('Status', old_record.Status IS DISTINCT FROM new_record.Status),
        STRUCT('CurrentBalance', old_record.CurrentBalance IS DISTINCT FROM new_record.CurrentBalance),
        STRUCT('Currency', old_record.Currency IS DISTINCT FROM new_record.Currency)
      ])
      WHERE changed
    ),
    ', '
  ) AS changed_columns
FROM paired
ORDER BY SAFE_CAST(AccountID AS INT64);



