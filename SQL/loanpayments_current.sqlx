config { type: "table", database: "retail-omkar-cli-org-dev", schema: "bankeva_silver", name: "loanpayments_current", dependencies: ["loanpayments"] }
SELECT * EXCEPT(source_file,source_sha256,record_sha256)
FROM `retail-omkar-cli-org-dev.bankeva_bronze.loanpayments`
QUALIFY ROW_NUMBER() OVER (PARTITION BY `PaymentID` ORDER BY source_day DESC, record_sha256 DESC) = 1
